<% layout("/layouts/boilerplate") %>

<div class="container mt-3">

  <!-- Listing title -->
  <div class="row">
    <div class="col-12 col-md-8">
      <h3><%= listing.title %></h3>
    </div>
  </div>

  <!-- Listing card -->
  <div class="row mt-3 listing-show-page">
    <div class="col-12 col-md-8">
      <div class="card listing-card">
        <img
          src="<%= listing.image.url %>"
          class="card-img-top"
          alt="listing_image"
        />
        <div class="card-body">

          <!-- ✅ OWNER SAFE -->
          <p class="card-text">
            Owned by 
            <i>
              <%= listing.owner ? listing.owner.username : "Unknown User" %>
            </i>
          </p>

          <p class="card-text"><%= listing.description %></p>
          <p class="card-text">&#8377; <%= listing.price.toLocaleString("en-IN") %></p>
          <p class="card-text"><%= listing.location %></p>
          <p class="card-text"><%= listing.country %></p>
        </div>
      </div>
    </div>
  </div>

  <!-- ✅ OWNER BUTTON SAFE -->
  <% if(currUser && listing.owner && listing.owner._id.equals(currUser._id)) { %>
  <div class="row my-3">
    <div class="col-12 d-flex gap-2">
      <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark">Edit</a>
      <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
        <button class="btn btn-dark">Delete</button>
      </form>
    </div>
  </div>
  <% } %>

  <!-- Review Form -->
  <% if(currUser) { %>
  <div class="row mt-4">
    <div class="col-12 col-md-8">
      <h4>Add your review</h4>

      <form action="/listings/<%= listing.id %>/reviews" method="POST" novalidate class="needs-validation">

        <div class="mb-3 mt-3">
          <label class="form-label">Rating</label>

          <fieldset class="starability-slot">
            <input type="radio" name="review[rating]" value="1" checked />
            <input type="radio" name="review[rating]" value="2" />
            <input type="radio" name="review[rating]" value="3" />
            <input type="radio" name="review[rating]" value="4" />
            <input type="radio" name="review[rating]" value="5" />
          </fieldset>
        </div>

        <div class="mb-3 mt-3">
          <label class="form-label">Comments</label>
          <textarea 
            name="review[comment]" 
            rows="5" 
            class="form-control"
            required
          ></textarea>
        </div>

        <button class="btn btn-outline-dark">Submit</button>
      </form>
    </div>
  </div>
  <% } %>

  <!-- All Reviews -->
  <div class="row mt-4">
    <div class="col-12 col-md-8">
      <p><b>All Reviews</b></p>

      <div class="reviews-grid">
        <% for (let review of listing.reviews) { %>

          <div class="review-card">

            <!-- ✅ SAFE AUTHOR -->
            <div class="review-avatar">
              <%= review.author ? review.author.username[0].toUpperCase() : "U" %>
            </div>

            <h5 class="review-username">
              @<%= review.author ? review.author.username : "Unknown" %>
            </h5>

            <p data-rating="<%= review.rating %>"></p>
            <p><%= review.comment %></p>

            <% if(currUser && review.author && review.author._id.equals(currUser._id)) { %>
            <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
              <button class="btn btn-sm btn-dark mt-2">Delete</button>
            </form>
            <% } %>

          </div>

        <% } %>
      </div>
    </div>
  </div>

</div>
